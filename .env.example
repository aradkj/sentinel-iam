# Application Settings
APP_NAME="Secure Identity & Access Management Service (IAM)"
APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:8080

# CORS Configuration (comma-separated list of allowed origins; never use wildcard *)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:8080

# PostgreSQL Database Configuration
POSTGRES_DB=iam_db
POSTGRES_USER=iam_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://iam_user:change_me@postgres:5432/iam_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Asymmetric (RS256) Key Configuration
# Generate local keys via:
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMP_2FA_TOKEN_EXPIRE_MINUTES=5

# Account Lockout & Brute-Force Protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Email Verification & Password Reset (MailHog in development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@iam-service.local
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Two-Factor Authentication (TOTP)
TOTP_ISSUER_NAME="Enterprise IAM Service"

# OAuth2 Social Login Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Session / OAuth State Encryption Secret (override via .env in production)
SESSION_SECRET_KEY=change_me_to_a_random_32_byte_hex_secret_in_env
